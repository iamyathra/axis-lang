{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AXIS",
  "scopeName": "source.axis",
  "fileTypes": ["ax"],
  "comment": "Generated by hand from src/parser.js/src/lexer.js's own real keyword and token lists (see AXIS_KEYWORDS below) - not guessed. Regenerate the keyword list any time parser.js's isKeyword/expectKeyword calls change: grep -oP 'expectKeyword\\(\"\\K[a-z]+' src/parser.js | sort -u",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#declarations" },
    { "include": "#property-key" },
    { "include": "#animate-target" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.axis",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.axis",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.axis", "match": "\\\\\"" }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "a number, optionally with a unit suffix (deg/s/ms/%) - see lexer.js's NUMBER token",
          "name": "constant.numeric.axis",
          "match": "-?\\b\\d+(\\.\\d+)?(deg|ms|s|%)?\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.axis",
          "match": "\\b(true|false|null|infinite)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "control flow / declarations - AXIS's real keyword set, from parser.js's own isKeyword/expectKeyword calls",
          "name": "keyword.control.axis",
          "match": "\\b(if|else|while|for|in|return|try|catch|await|async)\\b"
        },
        {
          "name": "keyword.other.declaration.axis",
          "match": "\\b(scene|page|component|fn|let|const|state|import|export|route|redirect|from)\\b"
        },
        {
          "name": "keyword.other.axis-domain.axis",
          "match": "\\b(animate|on|timeline|label|play|pause|resume|reverse|stop)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "'scene NAME' / 'component NAME' / 'fn NAME' - the declared name itself",
          "match": "\\b(scene|component|fn|timeline)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.declaration.axis" },
            "2": { "name": "entity.name.type.axis" }
          }
        },
        {
          "comment": "an object declaration - 'cube box {' - the type is a bare identifier, not a fixed keyword (AXIS's object types aren't reserved words, including component names used as instance types)",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
          "captures": {
            "1": { "name": "entity.name.tag.axis" },
            "2": { "name": "entity.name.function.axis" }
          }
        }
      ]
    },
    "property-key": {
      "patterns": [
        {
          "comment": "'color:' / 'material.metalness:' - a property path before ':'",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s*:",
          "captures": {
            "1": { "name": "variable.other.property.axis" }
          }
        }
      ]
    },
    "animate-target": {
      "patterns": [
        {
          "comment": "'rotation.y ->' inside an animate block",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s*->",
          "captures": {
            "1": { "name": "variable.other.property.axis" }
          }
        }
      ]
    }
  }
}
