// AXIS's timeline showcase - the thing a single-shot `animate` genuinely
// can't do: a real, multi-object, multi-property choreography with its own
// clock. One `timeline intro` here sequences a model growing in, five
// cards staggering into place (an ordinary `for` loop plus `at: reveal + i
// * 90` - stagger is just arithmetic, not a separate primitive), a spotlight
// flaring on, a camera dolly toward the centerpiece, and that centerpiece's
// own material turning from matte to polished metal - six different kinds
// of AXIS object (model, shape, light, camera, and two different materials)
// driven by one timeline, each step positioned either relative to the
// previous one or to a named `label`, not a hand-computed timestamp.
//
// Clicking the centerpiece once it's settled replays the whole thing
// (`play intro`) - the one playback control a timeline has this milestone.
//
// The page around it fades its own heading/subtitle in with an ordinary
// page-level `animate` - proving DOM and a scene's `timeline` can compose
// side by side (even though a DOM element isn't a `timeline` target itself
// yet - see docs/language.md's Timelines section for that boundary).

scene reveal {
    camera { position: (0, 3, 14) }

    ambientLight fill { intensity: 0.3 }
    directionalLight sun { direction: (-1, -1.2, -0.6) intensity: 1.4 shadows: true }
    spotLight spot { position: (0, 6, 3) target: (0, 0, 0) color: "#8fd3ff" intensity: 0 angle: 35 penumbra: 0.5 }

    plane ground {
        position: (0, -1.4, 0)
        rotation: (-90, 0, 0)
        scale: (24, 24, 1)
        color: "#1c1c26"
        material.roughness: 0.95
        receiveShadow: true
        castShadow: false
    }

    model centerpiece {
        src: "./assets/pyramid.glb"
        position: (0, 0, 0)
        scale: (0.01, 0.01, 0.01)
        material.metalness: 0.15
        material.roughness: 0.7
    }

    for i in range(0, 5) {
        cube ("card" + i) {
            position: ((i - 2) * 2.4, -3.5, 4)
            scale: (0.01, 0.01, 0.01)
            color: "#3a6ea5"
            material.metalness: 0.4
            material.roughness: 0.25
        }
    }

    timeline intro {
        animate centerpiece {
            scale.x -> 1.1
            scale.y -> 1.1
            scale.z -> 1.1
            duration: 900
            easing: easeOut
        }

        label reveal

        for i in range(0, 5) {
            animate ("card" + i) {
                position.y -> 0
                scale.x -> 0.7
                scale.y -> 0.7
                scale.z -> 0.7
                duration: 500
                easing: easeOut
                at: reveal + i * 90
            }
        }

        animate spot {
            intensity -> 30
            duration: 500
            at: previous - 300
        }

        label focus

        animate camera {
            position.z -> 7
            position.y -> 1.5
            duration: 1200
            easing: easeInOut
            at: focus + 200
        }

        animate centerpiece {
            material.metalness -> 0.9
            material.roughness -> 0.12
            duration: 800
            at: previous - 500
        }
    }

    on centerpiece.click {
        play intro
    }
}

page "AXIS" {
    container hero {
        direction: "column"
        gap: 8
        padding: 32
        background: "#0b0b12"

        heading title { content: "AXIS" color: white size: 40 opacity: 0 }
        text subtitle { content: "A native runtime for interactive 3D on the web." color: "#9c9cb8" opacity: 0 }

        viewport stage {
            scene: "reveal"
            width: "100%"
            height: 560
            radius: 16
        }
    }

    animate title { opacity -> 1 duration: 700ms }
    animate subtitle { opacity -> 1 duration: 700ms delay: 200ms }
}
