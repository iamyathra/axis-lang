// AXIS's flagship timeline example - one `timeline` choreographing DOM
// elements *and* a 3D scene together, driven by ordinary page scroll. Not
// a DOM animation and a 3D animation running side by side and happening to
// line up - one AST node, one schedule, one clock:
//
//   animate title { opacity -> 1 ... }              <- a real page element
//   animate ("stage.centerpiece") { ... }            <- a real 3D model,
//   animate ("stage.camera") { ... }                    inside the
//   animate ("stage.glow") { ... }                       `stage` viewport
//
// `("stage.centerpiece")` is how a page-level timeline step reaches into a
// `viewport`'s own embedded scene - `stage` names the viewport, `centerpiece`
// one of that scene's own objects (including "camera") - see
// docs/language.md's Timelines section for exactly what that does and does
// not let you cross-reference.
//
// `scrollTimeline: "story"` on `hero` (the container wrapping the heading,
// subtitle, *and* the viewport) is what makes the whole composition scroll
// together as one thing - the same property, same deterministic progress
// formula, `viewport.scrollTimeline` already uses for a scene-only
// timeline, just driving a page-level one here instead.

scene reveal {
    camera { position: (0, 2, 12) }

    ambientLight fill { intensity: 0.3 }
    directionalLight sun { direction: (-1, -1.2, -0.6) intensity: 1.5 shadows: true }
    spotLight glow { position: (0, 5, 3) target: (0, 0, 0) color: "#8fd3ff" intensity: 0 angle: 32 penumbra: 0.5 }

    plane ground {
        position: (0, -1.4, 0)
        rotation: (-90, 0, 0)
        scale: (24, 24, 1)
        color: "#1c1c26"
        material.roughness: 0.95
        receiveShadow: true
        castShadow: false
    }

    model centerpiece {
        src: "./assets/pyramid.glb"
        position: (0, 0, 0)
        scale: (0.01, 0.01, 0.01)
        material.metalness: 0.1
        material.roughness: 0.8
    }
}

page "AXIS - Unified Story" {
    container hero {
        direction: "column"
        gap: 8
        padding: 32
        background: "#0b0b12"
        scrollTimeline: "story"
        height: 2400

        heading title { content: "One timeline. DOM and 3D." color: white size: 40 opacity: 0 }
        text subtitle { content: "Scroll to choreograph both together." color: "#9c9cb8" opacity: 0 }

        viewport stage {
            scene: "reveal"
            width: "100%"
            height: 560
            radius: 16
        }
    }

    container footer {
        direction: "column"
        padding: 64
        background: "#0b0b12"

        text end { content: "End of the story." color: "#9c9cb8" }
    }

    timeline story {
        animate title { opacity -> 1 duration: 400 }

        label heroIn

        animate subtitle { opacity -> 1 duration: 400 at: heroIn + 150 }

        animate ("stage.centerpiece") {
            scale.x -> 1.1
            scale.y -> 1.1
            scale.z -> 1.1
            duration: 900
            easing: easeOut
            at: heroIn
        }

        animate ("stage.camera") {
            position.z -> 8
            duration: 900
            easing: easeOut
            at: heroIn
        }

        label settled

        animate ("stage.glow") { intensity -> 30 duration: 600 at: settled + 200 }

        animate ("stage.centerpiece") {
            rotation.y -> 180deg
            duration: 1400
            easing: easeInOut
            at: settled + 400
        }

        label polish

        animate ("stage.centerpiece") {
            material.metalness -> 0.95
            material.roughness -> 0.1
            duration: 900
            at: polish
        }

        animate ("stage.camera") {
            position.x -> 4
            position.z -> 5
            duration: 1200
            easing: easeInOut
            at: polish + 300
        }

        label finale

        animate ("stage.glow") { color -> "#ff9d5c" duration: 800 at: finale }

        animate ("stage.camera") {
            position.x -> 0
            position.z -> 6
            duration: 1000
            easing: easeInOut
            at: finale + 400
        }
    }
}
